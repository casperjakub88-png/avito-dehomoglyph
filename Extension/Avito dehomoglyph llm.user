// ==UserScript==
// @name         Avito Dehomoglyph + LLM (SPA, мост к расширению)
// @namespace    dehomoglyph
// @version      5.1.6
// @description  Исправляет подмену латиница<->кириллица на Avito. Фаза 1 — быстрая эвристика; фаза 2 — доуточнение неоднозначных токенов локальной LLM через безопасный мост к расширению.
// @match        *://www.avito.ru/*
// @match        *://*.avito.ru/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  /* ===================== НАСТРОЙКИ ===================== */
  const CODE_TO_LATIN   = true;   // токен с цифрой -> латиница (модели/серийники)
  const MARGIN          = 0.5;    // порог уверенности словаря (zipf)
  const NEIGHBOR_RADIUS = 20;     // сколько слов-соседей учитывать
  const DEBOUNCE_MS     = 300;    // пауза перед обработкой пачки изменений
  // Одиночные confusable-буквы, которые в РУ-прайсе означают единицу/валюту
  // (вольт, ампер, рубль) -> приводим к кириллице. T/C намеренно НЕ включены
  // (конфликт с TB и iPhone 5C/5S).
  const UNIT_LATIN = new Set(['A', 'B', 'P', 'p']);

  /* ===================== 2c: ЯКОРЯ И СЛОВАРИ ===================== */
  // Кириллические буквы БЕЗ латинского двойника — «якоря»: если в слове есть
  // такая буква, слово точно кириллическое, и гомоглифы в нём -> кириллица (ЭРА).
  const CYR_ANCHORS = new Set('бгджзилнптфцчшщъыьэюяБГДЖЗИЙЛПФЦЧШЩЪЫЬЭЮЯ');
  // Латинские буквы без кириллического двойника — латинские якоря (USB, HDMI…).
  const LAT_ANCHORS = new Set('dfghlmnqrtuvwzDFGLNQRUVWZ');
  // Известные латинские термины (в нижнем регистре, после нормализации в латиницу):
  // бренды/стандарты/порты -> латиница, даже если односложно/неоднозначно.
  const KNOWN_LATIN = new Set([
    'usb', 'usba', 'usbc', 'type', 'typec', 'hdmi', 'vga', 'rj', 'lan', 'ssd', 'hdd',
    'iphone', 'ipad', 'ipod', 'mac', 'pc', 'tv', 'led', 'lcd', 'oled', 'ups', 'pd',
    'qi', 'nfc', 'gps', 'sim', 'sd', 'gb', 'tb', 'mb', 'kb', 'abc', 'eu', 'euro',
    'auto', 'max', 'qumo', 'agni', 'ekf', 'twr', 'yahoo', 'wireless', 'fast', 'block', 'system', 'power',
  ]);
  // Цифро-буквенные коды, которые надо считать латиницей (модели телефонов и т.п.)
  const KNOWN_LATIN_CODE = new Set(['5s', '5c', '6s', '5se', 'se']);

  /* ===================== НАСТРОЙКИ LLM / МОСТА ===================== */
  // ⚠ Секрет должен СОВПАДАТЬ с тем, что задан в расширении (попап → Секрет моста).
  const BRIDGE_SECRET   = 'CHANGE-ME-7b1f9c2e-set-the-same-in-userscript';
  const LLM = {
    enabled:      true,    // фаза 2 (LLM) включена — тумблер в окне
    duplicate:    false,   // дублирование под Ctrl+F (шаг 2b) — пока заглушка
    onlyCardPage: true,    // LLM только на странице карточки объявления (не на выдаче)
    descriptionOnly: true, // на карточке — только блок описания
    maxTokens:    20,      // не больше N спорных токенов за проход (настраивается в окне)
    reasoning:    false,   // массовая фаза 2 — без рассуждения (быстрее); ручной вопрос всегда с рассуждением
    verbose:       false,   // логировать prompt и raw-ответ LLM
    bridgeTimeoutMs: 600000,
  };
  const TAG = '__avitoLLMBridge';

  // Кэш вердиктов LLM: ключ = токен|предложение -> 'cyr'|'lat'. Одинаковый текст
  // не гоняем через модель повторно (ускоряет выдачу и повторные заходы).
  const verdictCache = new Map();

  /* ===================== ПАМЯТЬ (localStorage) ===================== */
  // Настройки и кэш вердиктов переживают перезагрузку и общие для всех вкладок.
  const LS_CFG = 'avito_dh_cfg', LS_CACHE = 'avito_dh_cache';
  function loadPersisted() {
    try {
      const c = JSON.parse(localStorage.getItem(LS_CFG) || '{}');
      for (const k of ['enabled', 'duplicate', 'onlyCardPage', 'descriptionOnly', 'maxTokens', 'reasoning', 'verbose'])
        if (k in c) LLM[k] = c[k];
    } catch {}
    try {
      const arr = JSON.parse(localStorage.getItem(LS_CACHE) || '[]');
      if (Array.isArray(arr)) for (const [k, v] of arr) verdictCache.set(k, v);
    } catch {}
  }
  function saveCfg() {
    try {
      localStorage.setItem(LS_CFG, JSON.stringify({
        enabled: LLM.enabled, duplicate: LLM.duplicate, onlyCardPage: LLM.onlyCardPage,
        descriptionOnly: LLM.descriptionOnly, maxTokens: LLM.maxTokens, reasoning: LLM.reasoning,
      }));
    } catch {}
  }
  function saveCache() {
    try { localStorage.setItem(LS_CACHE, JSON.stringify([...verdictCache])); } catch {}
  }
  loadPersisted();   // применяем сохранённое ДО построения окна

  /* ===================== ДАННЫЕ ===================== */
