  const CYR_TO_LAT = {
    'а':'a','е':'e','о':'o','р':'p','с':'c','у':'y','х':'x','ѕ':'s','і':'i','ј':'j',
    'А':'A','В':'B','Е':'E','К':'K','М':'M','Н':'H','О':'O','Р':'P','С':'C','Т':'T',
    'Х':'X','У':'Y','І':'I','Ј':'J','Ѕ':'S'
  };
  const LAT_TO_CYR = {};
  for (const [c, l] of Object.entries(CYR_TO_LAT)) LAT_TO_CYR[l] = c;

  const INVISIBLE = /[\u200B\u200C\u200D\u2060\uFEFF\u00AD]/g;       // для replace
  const INVISIBLE_T = /[\u200B\u200C\u200D\u2060\uFEFF\u00AD]/;        // для .test()
  const isLatin = (ch) => (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z');
  const isCyr   = (ch) => ch >= '\u0400' && ch <= '\u04FF';

  /* ===================== ЯДРО ===================== */
  function classify(w) {
    let hasLat = false, hasCyr = false, latA = 0, cyrA = 0;
    for (const ch of w) {
      if (isLatin(ch)) { hasLat = true; if (!(ch in LAT_TO_CYR)) latA++; }
      else if (isCyr(ch)) { hasCyr = true; if (!(ch in CYR_TO_LAT)) cyrA++; }
    }
    if (!hasLat && !hasCyr) return 'none';
    if (latA > 0 && cyrA === 0) return 'lat';
    if (cyrA > 0 && latA === 0) return 'cyr';
    if (latA > 0 && cyrA > 0) return 'mixed';
    return 'ambig';
  }
  function convert(w, target) {
    let o = '';
    for (const ch of w) o += target === 'cyr' ? (LAT_TO_CYR[ch] || ch) : (CYR_TO_LAT[ch] || ch);
    return o;
  }
  function dictScore(w) {
    let cyr = '', lat = '';
    for (const ch of w) {
      cyr += (ch in LAT_TO_CYR) ? LAT_TO_CYR[ch] : ch;
      lat += (ch in CYR_TO_LAT) ? CYR_TO_LAT[ch] : ch;
    }
    return { ru: FREQ.ru[cyr.toLowerCase()] || 0, en: FREQ.en[lat.toLowerCase()] || 0 };
  }

  const SUPER   = /([A-Za-z\u0400-\u04FF0-9][A-Za-z\u0400-\u04FF0-9-]*)/;
  const LETTERS = /[A-Za-z\u0400-\u04FF]+/g;

  function letterScript(w) { return isCyr(w[0]) ? 'cyr' : 'lat'; }

  // 2c: есть ли в слове буква-якорь того или иного алфавита
  function anchorOf(w) {
    let cyr = false, lat = false;
    for (const ch of w) { if (CYR_ANCHORS.has(ch)) cyr = true; else if (LAT_ANCHORS.has(ch)) lat = true; }
    if (cyr && !lat) return 'cyr';
    if (lat && !cyr) return 'lat';
    return null;                       // якорей нет или конфликт — решаем иначе
  }
  // 2c: слово как латиница в нижнем регистре (для сверки со словарём терминов)
  function asLatinLower(w) {
    let s = '';
    for (const ch of w) s += (ch in CYR_TO_LAT) ? CYR_TO_LAT[ch] : ch;
    return s.toLowerCase();
  }
  function isKnownLatin(w) {
    const l = asLatinLower(w);
    if (KNOWN_LATIN.has(l)) return true;
    if (KNOWN_LATIN_CODE.has(l)) return true;
    return false;
  }

  function buildUnits(text) {
    const units = [];
    let group = 0;
    for (const chunk of text.replace(INVISIBLE, '').split(SUPER)) {
      if (chunk === '') continue;
      if (SUPER.test(chunk) && /[A-Za-z\u0400-\u04FF]/.test(chunk)) {
        group++;                                  // общий id для рун одного дефис-токена
        const hasDigit = /\d/.test(chunk);
        let last = 0, m; LETTERS.lastIndex = 0;
        while ((m = LETTERS.exec(chunk)) !== null) {
          if (m.index > last) units.push({ fixed: chunk.slice(last, m.index) });
          units.push({ word: true, text: m[0], hasDigit, chunkText: chunk, len: m[0].length, group, script: classify(m[0]), resolved: null });
          last = m.index + m[0].length;
        }
        if (last < chunk.length) units.push({ fixed: chunk.slice(last) });
      } else units.push({ fixed: chunk });
    }
    return units;
  }

  // Разрешённый скрипт многобуквенной руны в том же дефис-токене (TYPE-С -> по TYPE)
  function groupSibling(units, i) {
    const g = units[i].group;
    for (const x of units)
      if (x.word && x.group === g && x.len >= 2 && (x.resolved === 'lat' || x.resolved === 'cyr')) return x.resolved;
    return null;
  }
  // ближайшее предыдущее слово-юнит (через любые не-слова: пробел, дефис)
  function prevWordUnit(units, i) {
    for (let k = i - 1; k >= 0; k--) if (units[k].word) return units[k];
    return null;
  }
  function nextWordUnit(units, i) {
    for (let k = i + 1; k < units.length; k++) if (units[k].word) return units[k];
    return null;
  }
  function neighborVote(units, i) {
    let cyr = 0, lat = 0;
    for (let k = i - 1, d = 1; k >= 0 && d <= NEIGHBOR_RADIUS; k--)
      if (units[k].word) { if (units[k].resolved === 'cyr') cyr += 1 / d; else if (units[k].resolved === 'lat') lat += 1 / d; d++; }
    for (let k = i + 1, d = 1; k < units.length && d <= NEIGHBOR_RADIUS; k++)
      if (units[k].word) { if (units[k].resolved === 'cyr') cyr += 1 / d; else if (units[k].resolved === 'lat') lat += 1 / d; d++; }
    if (cyr > lat) return 'cyr';
    if (lat > cyr) return 'lat';
    return null;
  }
  function normalizeText(text, docLang, collector, node) {
    const units = buildUnits(text);

    // Проход 1: всё, что разрешается без контекста (кроме одиночных букв).
    for (const u of units) {
      if (!u.word) continue;

      // 2c-ПРИОРИТЕТ A: буква-якорь решает весь токен (ЭРА: Э -> cyr; USB: нет cyr-якоря,
      // есть lat-якоря S,B... -> lat). Перекрывает даже 'mixed'.
      if (u.len >= 2) {
        const anc = anchorOf(u.text);
        if (anc) { u.resolved = anc; continue; }
      }

      if (u.script === 'lat' || u.script === 'cyr') { u.resolved = u.script; continue; }
      if (u.script === 'none') { u.resolved = null; continue; }

      // 2c-ПРИОРИТЕТ B: известный латинский термин/код (usb, type, abc, 5s…) -> lat.
      if (u.len >= 2 && isKnownLatin(u.text)) { u.resolved = 'lat'; continue; }

      if (u.script === 'mixed') { u.resolved = null; continue; }   // настоящий микс — в LLM

      // ambig (слово целиком из confusable-букв)
      if (u.len >= 2) {
        if (u.hasDigit && CODE_TO_LATIN) u.resolved = 'lat';        // модель/серийник
        else {
          const { ru, en } = dictScore(u.text);
          u.resolved = ((ru || en) && Math.abs(ru - en) >= MARGIN) ? (ru > en ? 'cyr' : 'lat') : null;
        }
      }
      // одиночные буквы — во втором проходе (нужен контекст)
    }

    // Проход 2: одиночные буквы и оставшиеся неоднозначные.
    for (let i = 0; i < units.length; i++) {
      const u = units[i];
      if (!u.word || u.script !== 'ambig' || u.resolved !== null) continue;
      if (u.len === 1) {
        const sib = groupSibling(units, i);
        // groupSibling='lat' надёжен (TYPE, USB — настоящие латинские якоря).
        // groupSibling='cyr' — НЕТ: «Туре-С» = «Type-C», но «Туре» имеет кирилличный
        // якорь «у», что некорректно тянет С в cyr. Заглавные одиночные → LLM.
        if (sib === 'lat') { u.resolved = 'lat'; continue; }
        if (sib === 'cyr' && (u.text === u.text.toLowerCase() || u.text !== u.text.toUpperCase())) {
          u.resolved = 'cyr'; continue;   // строчная buква (предлог «с» в «Туре-с») — ок
        }
        // заглавная одиночная с cyr-соседом — неоднозначно, отдаём в LLM (resolved=null)
        // 2c: одиночная c/с сразу после слова "type" (через пробел/дефис) — это type-c
        if (/^[cсC]$/.test(u.text)) {
          const prevWord = prevWordUnit(units, i);
          if (prevWord && asLatinLower(prevWord.text) === 'type') { u.resolved = 'lat'; continue; }
        }
        // 2c: одиночная ЗАГЛАВНАЯ confusable-буква без цифры, стоящая рядом с латинским
        // соседом (USBA+С, USB A C) — технический контекст, неоднозначно -> отдаём в LLM.
        // (строчные предлоги с/в среди русских слов сюда НЕ попадают — нет лат. соседа.)
        if (!u.hasDigit && u.text === u.text.toUpperCase() && u.text !== u.text.toLowerCase()) {
          const pv = prevWordUnit(units, i), nx = nextWordUnit(units, i);
          if ((pv && pv.resolved === 'lat') || (nx && nx.resolved === 'lat')) { u.resolved = null; continue; }
        }
        const sc = letterScript(u.text);
        if (u.hasDigit) {
          // 2c: модельный код вида "Р-0010" / "P-0010" (буква — дефис — цифры).
          // Одиночная confusable-буква здесь смыслово неоднозначна: «Р-0010»
          // в техконтексте обычно лат. P, а «5В/2.1А» — кириллица. Отличие —
          // буква стоит ПЕРЕД дефисом+цифрами, а не после цифр. Гоним в LLM.
          if (/^[A-Za-zЀ-ӿ]-\d/.test(u.chunkText || '')) { u.resolved = null; continue; }
          if (sc === 'lat' && UNIT_LATIN.has(u.text) && docLang === 'cyr') u.resolved = 'cyr'; // 5B->5В, 500p->500р
          else if (sc === 'lat') u.resolved = 'lat';                 // 5S/5C — модель
          else u.resolved = 'cyr';                                   // 5В/2.1А — уже кириллица, уверенно cyr (НЕ в LLM)
        } else {
          if (sc === 'cyr') u.resolved = 'cyr';                      // одиночная кириллица (предлог с/в) — уверенно cyr (НЕ в LLM)
          else u.resolved = neighborVote(units, i) || docLang || null; // одиночная латиница -> контекст, иначе в LLM
        }
      } else {
        u.resolved = neighborVote(units, i) || docLang || null;       // ничья словаря у многобуквенного -> в LLM
      }
    }

    // Сборка результата + (опц.) сбор ОСТАТКА для фазы 2 (LLM).
    // Контекст берём вокруг РЕАЛЬНОЙ позиции токена (не indexOf — иначе для
    // частых букв вроде "с" брался бы не тот фрагмент).
    let out = '', touched = false;
    for (const u of units) {
      if (!u.word) { out += u.fixed; continue; }
      if (u.resolved) { const c = convert(u.text, u.resolved); out += c; if (c !== u.text) touched = true; }
      else {
        const pos = out.length;          // позиция этого токена в собираемом тексте
        out += u.text;
        if (collector && u.script === 'ambig' && u.resolved === null) {
          const ctx = contextAt(text, pos, u.text);
          collector.push({ node, token: u.text, pos, sentence: ctx.sentence, sentOffset: ctx.offset, chunkText: u.chunkText || '' });
        }
      }
    }
    return touched ? out : null;
  }

  // контекст вокруг конкретной позиции: целое предложение, в котором стоит токен
  function contextAt(text, pos, token) {
    // pos считалась в собранном тексте; в исходном text позиция может отличаться
    // из-за невидимых символов, но для границ предложения достаточно близко —
    // выровняем по ближайшему вхождению token не дальше ±5 симв. от pos.
    let p = pos;
    if (text.substr(p, token.length) !== token) {
      const around = text.slice(Math.max(0, pos - 8), pos + token.length + 8);
      const rel = around.indexOf(token);
      if (rel >= 0) p = Math.max(0, pos - 8) + rel;
    }
    let s = p, e = p + token.length;
    while (s > 0 && !/[.!?;\n]/.test(text[s - 1])) s--;
    while (e < text.length && !/[.!?;\n]/.test(text[e])) e++;
    let sliceStart = s, sliceEnd = e;
    // если предложение слишком длинное — сузим до окна ±60 симв. вокруг токена
    let prefix = '', suffix = '';
    if (e - s > 220) {
      sliceStart = Math.max(0, p - 60);
      sliceEnd   = Math.min(text.length, p + token.length + 60);
      if (sliceStart > 0) prefix = '…';
      if (sliceEnd < text.length) suffix = '…';
    }
    let raw = text.slice(sliceStart, sliceEnd);
    // абсолютный offset токена внутри raw до trim
    let offset = p - sliceStart;
    // обрезаем пробелы СЛЕВА и корректируем offset; справа — просто trimEnd
    const lead = raw.length - raw.replace(/^\s+/, '').length;
    raw = raw.slice(lead).replace(/\s+$/, '');
    offset -= lead;
    const sent = prefix + raw + suffix;
    offset += prefix.length;
    return { sentence: sent.slice(0, 240), offset: Math.max(0, Math.min(offset, sent.length - token.length)) };
  }

  /* ===================== DOM ===================== */
  const SKIP = new Set(['SCRIPT','STYLE','NOSCRIPT','TEXTAREA','INPUT','CODE','PRE','SELECT','OPTION']);

  function makeWalker(root) {
    return document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        const p = n.parentNode;
        if (!p) return NodeFilter.FILTER_REJECT;
        if (SKIP.has(p.nodeName)) return NodeFilter.FILTER_REJECT;
        if (p.isContentEditable) return NodeFilter.FILTER_REJECT;
        const v = n.nodeValue;
        if (!v || v.length < 2) return NodeFilter.FILTER_REJECT;
        // принимаем узлы с любыми буквами: нужны и чисто-кириллические (ТУРЕ, Мах)
        if (!/[A-Za-z\u0400-\u04FF]/.test(v)) {
          if (!INVISIBLE_T.test(v)) return NodeFilter.FILTER_REJECT;
        }
        return NodeFilter.FILTER_ACCEPT;
      }
    });
  }

  let docLang = 'cyr';
  function computeDocLang() {
    let cyr = 0, lat = 0;
    const body = document.body;
    if (!body) return;
    const txt = body.innerText || '';
    for (const w of txt.split(/[^A-Za-z\u0400-\u04FF]+/)) {
      if (!w) continue;
      const c = classify(w);
      if (c === 'cyr') cyr++; else if (c === 'lat') lat++;
      if (cyr + lat > 4000) break;
    }
    docLang = cyr >= lat ? 'cyr' : 'lat';
  }

  function processSubtree(root) {
    if (root.nodeType === Node.TEXT_NODE) { normalizeNode(root); return; }
    if (root.nodeType !== Node.ELEMENT_NODE) return;
    if (SKIP.has(root.nodeName)) return;
    const walker = makeWalker(root);
    const nodes = []; let n;
    while ((n = walker.nextNode())) nodes.push(n);
    for (const node of nodes) normalizeNode(node);
  }
  function normalizeNode(node) {
    const fixed = normalizeText(node.nodeValue, docLang);
    if (fixed !== null && fixed !== node.nodeValue) node.nodeValue = fixed;
  }

  /* ===================== НАБЛЮДАТЕЛЬ + SPA ===================== */
  let observer = null, pending = new Set(), scheduled = false, busy = false;

  function connect() {
    if (!observer) {
      observer = new MutationObserver((muts) => {
        for (const mut of muts) {
          if (mut.type === 'childList') {
            mut.addedNodes.forEach((n) => {
              if (n.nodeType === Node.ELEMENT_NODE || n.nodeType === Node.TEXT_NODE) pending.add(n);
            });
          } else if (mut.type === 'characterData') {
            pending.add(mut.target);
          }
        }
        schedule();
      });
    }
    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  }
  function schedule() {
    if (scheduled) return;
    scheduled = true;
    const cb = () => flush();
    (window.requestIdleCallback ? requestIdleCallback(cb, { timeout: DEBOUNCE_MS + 300 }) : setTimeout(cb, DEBOUNCE_MS));
  }
  function flush() {
    scheduled = false;
    if (busy) { schedule(); return; }
    busy = true;
    if (observer) observer.disconnect();              // не реагируем на собственные правки
    const batch = Array.from(pending); pending.clear();
    for (const node of batch) {
      if (node.nodeType === Node.TEXT_NODE) { if (node.isConnected) normalizeNode(node); }
      else if (node.nodeType === Node.ELEMENT_NODE && node.isConnected) processSubtree(node);
    }
    connect();
    busy = false;
  }

  function fullScan() {
    if (!document.body) return;
    busy = true;
    if (observer) observer.disconnect();
    computeDocLang();
    processSubtree(document.body);
    connect();
    busy = false;
  }

  // SPA-переходы: перехватываем смену истории и перечищаем новый контент
  function hookHistory() {
    const fire = () => setTimeout(() => { fullScan(); if (LLM.enabled) setTimeout(runLLMPhase, 1200); }, 600);
    const wrap = (name) => {
      const orig = history[name];
      history[name] = function () { const r = orig.apply(this, arguments); fire(); return r; };
    };
    wrap('pushState');
    wrap('replaceState');
    window.addEventListener('popstate', fire);
  }

  /* ===================== ФАЗА 2: МОСТ К LLM ===================== */
  async function hmac(secret, msg) {
    const enc = new TextEncoder();
    const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
    const sig = await crypto.subtle.sign('HMAC', key, enc.encode(msg));
    return Array.from(new Uint8Array(sig)).map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  function randId() {
    const a = new Uint8Array(16); crypto.getRandomValues(a);
    return Array.from(a).map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  function bpost(obj) { window.postMessage(Object.assign({ [TAG]: true, dir: 'to-ext' }, obj), location.origin); }

  const _pending = new Map(), _chall = new Map();
  window.addEventListener('message', (ev) => {
    if (ev.source !== window) return;
    const d = ev.data;
    if (!d || d[TAG] !== true || d.dir !== 'to-page') return;
    if (d.type === 'challenge') { const w = _chall.get(d.nonce); if (w) { _chall.delete(d.nonce); w(d.challenge); } return; }
    if (d.type === 'response') { const p = _pending.get(d.requestId); if (p) { _pending.delete(d.requestId); d.error ? p.reject(new Error(d.error)) : p.resolve(d.result); } }
  });
  function getChallenge() {
    return new Promise((resolve, reject) => {
      const nonce = randId(); _chall.set(nonce, resolve); bpost({ type: 'hello', nonce });
      setTimeout(() => { if (_chall.has(nonce)) { _chall.delete(nonce); reject(new Error('мост не ответил (расширение установлено? секрет совпадает?)')); } }, 4000);
    });
  }
  // Копия buildMessages/parseVerdict из llm-backends.js (userscript строит промпт сам).
  const LLM_SYSTEM =
    'Определи, каким алфавитом ПО СМЫСЛУ записано выделенное слово в русском объявлении — кириллица или латиница.\n' +
    'Проверяй В ТАКОМ ПОРЯДКЕ:\n' +
    'ШАГ 1. Обозначает ли слово физическую величину или цену — напряжение, ток, мощность, частоту, вес, ' +
    'размер, длину, объём, деньги? Если ДА → КИРИЛЛИЦА, даже если рядом стоят USB, зарядка, прицеп, диск. ' +
    'Единица остаётся единицей независимо от технического окружения. ' +
    'Примеры: 5B при USB = вольты → кириллица; 2.1A = амперы → кириллица; 500p = рубли → кириллица; 5T у прицепа = тонны → кириллица.\n' +
    'ШАГ 2. Только если это НЕ величина и НЕ цена: название/модель/стандарт/разъём/код/бренд или единица ' +
    'цифровой памяти? Тогда → ЛАТИНИЦА. Примеры: iPhone 5C, 5S → латиница; type C, USB, HDMI → латиница; ' +
    '5T у жёсткого диска = терабайты → латиница; Yahoo = бренд; ABC = латинское слово. ' +
    'Одиночная буква после списка разъёмов (4xUSBA+C, 2xUSB+C, USBA+C) ' +
    'обозначает тип порта Type-C → ЛАТИНИЦА, это НЕ физическая единица.\n' +
    'Русские слова и предлоги (с, в, о) — кириллица.\n' +
    'ШАГ 3. ТАЙМ-БРЕЙКЕР (только если шаги 1–2 не дали однозначного ответа): ' +
    'если выделенная буква стоит в модельном коде или серийном номере (буквы+цифры, ' +
    'дефис+цифры — например «P-0010», «SFU2PD»), а остальной контекст фразы содержит ' +
    'преимущественно латинские слова (бренды, стандарты, коды), выбери → ЛАТИНИЦА. ' +
    'Не возвращай «невозможно определить» — всегда давай один из двух вердиктов.';
  function buildLLMMessages(token, context, offset, title, reasoning, chunkText) {
    const tail = reasoning
      ? 'Кратко (1 предложение) объясни смысл, затем последней строкой строго: ВЕРДИКТ: кириллица ИЛИ ВЕРДИКТ: латиница'
      : 'Ответь одним словом: кириллица или латиница';
    // Маркер <<<…>>> ставится по ТОЧНОЙ позиции — в строке может быть несколько
    // одинаковых букв, нужна именно та, по которой собран токен.
    let markedCtx;
    if (typeof offset === 'number' && offset >= 0 && context.substr(offset, token.length) === token) {
      markedCtx = context.slice(0, offset) + '<<<' + token + '>>>' + context.slice(offset + token.length);
    } else {
      markedCtx = context.replace(token, '<<<' + token + '>>>');   // fallback
    }
    // Если чанк значимо короче контекста — показываем его отдельно как «ближайшее
    // окружение»: LLM не отвлекается на начало длинного предложения о фильтре/устройстве
    // и видит главный сигнал («4xUSBA+<<<С>>>» = список разъёмов → Latin C).
    const chunk = (chunkText || '').trim();
    const chunkMarked = chunk && chunk !== context.trim() && chunk.includes(token)
      ? chunk.replace(token, '<<<' + token + '>>>')
      : '';
    const user =
      (title ? 'Объявление: "' + title + '"\n' : '') +
      (chunkMarked ? 'Непосредственное окружение: "' + chunkMarked + '"\n' : '') +
      'Фраза: "' + markedCtx + '"\n' +
      'Внимание: оцени ИМЕННО ту букву "' + token + '", которая заключена в маркеры <<< >>> ' +
      '(в этой фразе может быть несколько таких букв — другие НЕ учитывай). ' +
      'Какой алфавит у этой конкретной буквы — кириллица или латиница?';
    return [
      { role: 'system', content: LLM_SYSTEM + '\n' + tail },
      { role: 'user', content: user },
    ];
  }
  function parseLLMVerdict(text) {
    const norm = (w) => (/кир/i.test(w) || /^cyr/i.test(w) ? 'cyr' : 'lat');
    const m = [...text.matchAll(/ВЕРДИКТ\s*:\s*(кириллиц\w*|латиниц\w*|cyr|lat)/gi)];
    if (m.length) return norm(m[m.length - 1][1]);
    const t = text.toLowerCase();
    const hasCyr = /кириллиц/.test(t) || /\bcyr\b/.test(t);
    const hasLat = /латиниц/.test(t) || /\blat\b/.test(t);
    if (hasCyr && !hasLat) return 'cyr';
    if (hasLat && !hasCyr) return 'lat';
    const lc = Math.max(t.lastIndexOf('кириллиц'), t.lastIndexOf('cyr'));
    const ll = Math.max(t.lastIndexOf('латиниц'), t.lastIndexOf('lat'));
    if (lc === -1 && ll === -1) return null;
    return lc > ll ? 'cyr' : 'lat';
  }

  // Отправка одного chat-запроса через мост (одна HMAC-рукопожатие на вызов).
  async function llmChat(jobId, messages, options) {
    const challenge = await getChallenge();
    const requestId = randId();
    const payload = { cmd: 'chat', jobId, messages, options, meta: { client: 'avito-dehomoglyph', task: 'verify-token' } };
    const proof = await hmac(BRIDGE_SECRET, challenge + '|' + requestId + '|' + JSON.stringify(payload));
    return new Promise((resolve, reject) => {
      _pending.set(requestId, { resolve, reject });
      bpost({ type: 'request', requestId, challenge, proof, payload });
      setTimeout(() => {
        if (_pending.has(requestId)) { _pending.delete(requestId); reject(new Error('LLM не ответила (таймаут)')); }
      }, LLM.bridgeTimeoutMs);
    });
  }

  // Отмена списка jobId через мост.
  async function llmCancel(jobIds) {
    if (!jobIds || !jobIds.length) return;
    try {
      const challenge = await getChallenge();
      const requestId = randId();
      const payload = { cmd: 'cancel', jobIds };
      const proof = await hmac(BRIDGE_SECRET, challenge + '|' + requestId + '|' + JSON.stringify(payload));
      await new Promise((resolve) => {
        _pending.set(requestId, { resolve, reject: resolve });
        bpost({ type: 'request', requestId, challenge, proof, payload });
        setTimeout(() => { _pending.delete(requestId); resolve(); }, 4000);
      });
    } catch {}
  }

  function pageTitle() {
    const h1 = document.querySelector('[data-marker="item-view/title-info"], .js-item-view-title-info, [itemprop="name"]');
    const raw = (h1 && h1.textContent || '').trim();
    // Отфильтровываем стоп-слова и слишком короткие строки — они не несут смысла для LLM.
    const STOP = /^(главная|avito|авито|каталог|объявления|поиск|фильтр|корзина|избранное|войти|регистрация)$/i;
    if (!raw || raw.split(/\s+/).length <= 2 || STOP.test(raw)) return '';
    return raw.slice(0, 120);
  }
  function descriptionRoot() {
    return document.querySelector('[data-marker="item-view/item-description"], #bx_item-description, [itemprop="description"]');
  }
  function isCardPage() {
    return !!document.querySelector('.js-item-view-title-info, [data-marker="item-view/item-description"]') || /\/\d+$/.test(location.pathname);
  }
  // где собирать спорные токены для LLM: на карточке — только описание (если включено),
  // на выдаче (если разрешено) — вся страница.
  function collectRoot() {
    if (isCardPage() && LLM.descriptionOnly) return descriptionRoot() || null;
    return document.body;
  }

  function applyVerdict(node, token, script) {
    if (!node || !node.isConnected || !script) return false;
    const conv = convert(token, script);
    if (conv === token) return false;
    const v = node.nodeValue;
    const idx = v.indexOf(token);
    if (idx < 0) return false;
    node.nodeValue = v.slice(0, idx) + conv + v.slice(idx + token.length);
    return true;
  }

  let phase2Running = false;
  let currentSession = [];   // jobId-ы текущей сессии (для отмены)
  async function runLLMPhase() {
    if (!LLM.enabled || phase2Running) return;
    if (LLM.onlyCardPage && !isCardPage()) { ui.setStatus('LLM: только на карточке объявления'); return; }
    const root = collectRoot();
    if (!root) { ui.setStatus('LLM: блок описания не найден'); return; }
    phase2Running = true;
    try {
      // собрать остаток по выбранному корню (описание на карточке / страница на выдаче)
      const collector = [];
      const walker = makeWalker(root);
      let n; while ((n = walker.nextNode())) {
        if (collector.length >= LLM.maxTokens * 4) break;
        normalizeText(n.nodeValue, docLang, collector, n);
      }
      // уникализируем; готовые из кэша применяем сразу, в LLM шлём только новые
      const seen = new Set(); const fresh = []; const cachedHits = [];
      for (const c of collector) {
        const key = c.token + '|' + c.sentence;
        if (seen.has(key)) continue; seen.add(key);
        if (verdictCache.has(key)) cachedHits.push({ c, script: verdictCache.get(key) });
        else fresh.push(c);
        if (fresh.length >= LLM.maxTokens) break;
      }

      // применить кэшированные вердикты сразу
      if (cachedHits.length) {
        if (observer) observer.disconnect();
        let ca = 0;
        for (const h of cachedHits) if (h.script && applyVerdict(h.c.node, h.c.token, h.script)) ca++;
        connect();
        ui.log('из кэша применено: ' + ca + '/' + cachedHits.length);
      }

      if (!fresh.length) { ui.setStatus('LLM: новых спорных токенов нет' + (cachedHits.length ? ' (кэш: ' + cachedHits.length + ')' : '')); return; }

      const title = pageTitle();
      const sessionId = randId().slice(0, 8);
      const sessionJobIds = fresh.map((_, i) => sessionId + '-' + i);
      currentSession = sessionJobIds.slice();   // для кнопки «Стоп»

      ui.setStatus('LLM: отправляю ' + fresh.length + ' токенов…');
      ui.log('фаза 2: ' + fresh.length + ' → LLM' + (cachedHits.length ? ', ' + cachedHits.length + ' из кэша' : '') + ' [сессия ' + sessionId + ']');

      // Запускаем N параллельных chat-запросов; каждый встаёт в очередь на стороне аддона.
      // Результаты применяем к DOM по мере прихода (не ждём всех).
      if (observer) observer.disconnect();
      let applied = 0, confirmed = 0, noVerdict = 0, done = 0;
      const jobs = fresh.map((c, i) => {
        const msgs = buildLLMMessages(c.token, c.sentence, c.sentOffset, title, LLM.reasoning, c.chunkText);
        if (LLM.verbose) {
          ui.log('→ LLM [' + c.token + '] context: ' + msgs[1].content.replace(/\n/g, ' | '));
        }
        return llmChat(sessionJobIds[i], msgs, { reasoning: LLM.reasoning, max_tokens: 200 })
          .then((resp) => {
            if (!resp || !resp.ok || resp.cancelled) return;
            if (LLM.verbose && resp.raw) {
              ui.log('← LLM [' + c.token + ']: ' + resp.raw.trim());
            }
            const script = parseLLMVerdict(resp.raw || '');
            if (script) {
              verdictCache.set(c.token + '|' + c.sentence, script);
              const noop = convert(c.token, script) === c.token;
              if (applyVerdict(c.node, c.token, script)) applied++;
              else if (noop) confirmed++;
            } else { noVerdict++; }
            done++;
            ui.log('  ' + c.token + ' → ' + (script || '— (нет вердикта)') +
              (script && convert(c.token, script) === c.token ? ' (подтверждено)' : ''));
            ui.setStatus('LLM: ' + done + '/' + fresh.length + ' (применено ' + applied + ')');
          })
          .catch((e) => { ui.log('  ' + c.token + ' → ошибка: ' + (e && e.message)); done++; });
      });
      await Promise.allSettled(jobs);
      currentSession = [];
      saveCache();
      connect();
      const parts = ['применено ' + applied];
      if (confirmed) parts.push('подтверждено ' + confirmed);
      if (noVerdict) parts.push('без вердикта ' + noVerdict);
      ui.setStatus('LLM: ' + parts.join(', ') + '/' + fresh.length);
      ui.log('фаза 2 завершена: ' + parts.join(', '));
    } catch (e) {
      ui.setStatus('LLM: сбой');
      ui.log('сбой фазы 2: ' + (e && e.message));
    } finally {
      phase2Running = false;
    }
  }

  /* ===================== ОКНО (слева, сворачиваемое) ===================== */
  const ui = (function () {
    let panel, bubble, logBox, statusEl;
    function build() {
      bubble = document.createElement('div');
      bubble.textContent = 'Аа';
      bubble.title = 'Dehomoglyph + LLM';
      bubble.style.cssText = 'position:fixed;left:12px;bottom:12px;z-index:2147483647;width:42px;height:42px;border-radius:50%;background:#2563eb;color:#fff;display:none;align-items:center;justify-content:center;cursor:pointer;font:600 15px system-ui;box-shadow:0 3px 12px rgba(0,0,0,.3)';
      bubble.onclick = () => { bubble.style.display = 'none'; panel.style.display = 'flex'; };
      document.body.appendChild(bubble);

      panel = document.createElement('div');
      panel.style.cssText = 'position:fixed;left:12px;bottom:12px;z-index:2147483647;width:300px;background:#fff;border:1px solid #888;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.25);font:13px system-ui;color:#111;display:flex;flex-direction:column;overflow:hidden';
      panel.innerHTML =
        '<div style="padding:7px 10px;background:#2563eb;color:#fff;font-weight:600;display:flex;justify-content:space-between;align-items:center">' +
          '<span>Dehomoglyph + LLM</span><span id="dh-min" style="cursor:pointer;font-size:18px">–</span></div>' +
        '<div style="padding:8px 10px;display:flex;flex-direction:column;gap:6px">' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-llm"> Доуточнять через LLM (фаза 2)</label>' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-dup"> Дублировать под Ctrl+F <span style="color:#999">(скоро)</span></label>' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-card"> LLM только на карточке</label>' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-desc"> На карточке — только описание</label>' +
          '<label style="display:flex;align-items:center;gap:6px">Лимит токенов: <input type="number" id="dh-max" min="1" max="200" style="width:60px;padding:3px 5px;border:1px solid #ccc;border-radius:5px"></label>' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-reason"> Рассуждение в фазе 2 (медленнее)</label>' +
          '<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="dh-verbose"> Verbose: лог prompt + ответ LLM</label>' +
          '<div style="display:flex;gap:6px">' +
            '<button id="dh-run" style="flex:1;padding:6px 10px;border:0;border-radius:7px;background:#16a34a;color:#fff;cursor:pointer">Запустить LLM</button>' +
            '<button id="dh-stop" style="padding:6px 10px;border:0;border-radius:7px;background:#92400e;color:#fff;cursor:pointer" title="Отменить текущую очередь LLM">Стоп</button>' +
            '<button id="dh-clear" style="padding:6px 10px;border:0;border-radius:7px;background:#b91c1c;color:#fff;cursor:pointer" title="Очистить запомненные вердикты">Память ✕</button>' +
          '</div>' +
          '<div id="dh-status" style="font-size:11px;color:#555">готово</div>' +
          '<details style="margin-top:4px"><summary style="cursor:pointer;font-size:11px;color:#444">Спросить LLM вручную</summary>' +
            '<div style="display:flex;flex-direction:column;gap:4px;margin-top:5px">' +
              '<input id="dh-q-token" placeholder="слово (напр. 5B или розеток+4xUSBA+С)" style="padding:4px 6px;border:1px solid #ccc;border-radius:5px">' +
              '<input id="dh-q-ctx" placeholder="фраза-контекст (необязательно)" style="padding:4px 6px;border:1px solid #ccc;border-radius:5px">' +
              '<button id="dh-ask" style="padding:5px 10px;border:0;border-radius:6px;background:#7c3aed;color:#fff;cursor:pointer">Спросить с рассуждением</button>' +
            '</div></details>' +
        '</div>' +
        '<pre id="dh-log" style="margin:0;padding:6px 10px;background:#0b1020;color:#cbd5e1;font:10px/1.4 ui-monospace,monospace;white-space:pre-wrap;max-height:160px;overflow:auto"></pre>';
      document.body.appendChild(panel);
      logBox = panel.querySelector('#dh-log');
      statusEl = panel.querySelector('#dh-status');
      panel.querySelector('#dh-min').onclick = () => { panel.style.display = 'none'; bubble.style.display = 'flex'; };
      const cbLlm = panel.querySelector('#dh-llm'), cbDup = panel.querySelector('#dh-dup'),
            cbCard = panel.querySelector('#dh-card'), cbDesc = panel.querySelector('#dh-desc'),
            cbReason = panel.querySelector('#dh-reason'), cbVerbose = panel.querySelector('#dh-verbose'),
            inMax = panel.querySelector('#dh-max');
      cbLlm.checked = LLM.enabled; cbDup.checked = LLM.duplicate;
      cbCard.checked = LLM.onlyCardPage; cbDesc.checked = LLM.descriptionOnly;
      cbReason.checked = LLM.reasoning; cbVerbose.checked = LLM.verbose; inMax.value = LLM.maxTokens;
      cbLlm.onchange = () => { LLM.enabled = cbLlm.checked; saveCfg(); };
      cbDup.onchange = () => { LLM.duplicate = cbDup.checked; saveCfg(); };
      cbCard.onchange = () => { LLM.onlyCardPage = cbCard.checked; saveCfg(); };
      cbDesc.onchange = () => { LLM.descriptionOnly = cbDesc.checked; saveCfg(); };
      cbReason.onchange = () => { LLM.reasoning = cbReason.checked; saveCfg(); };
      cbVerbose.onchange = () => { LLM.verbose = cbVerbose.checked; saveCfg(); };
      inMax.onchange = () => { const v = parseInt(inMax.value); if (v > 0) { LLM.maxTokens = v; saveCfg(); } };
      panel.querySelector('#dh-run').onclick = () => runLLMPhase();
      panel.querySelector('#dh-stop').onclick = async () => {
        if (!currentSession.length) { ui.log('нечего останавливать'); return; }
        ui.log('отмена сессии (' + currentSession.length + ' задач)…');
        await llmCancel(currentSession.slice());
        currentSession = [];
        ui.setStatus('LLM: отменено');
      };
      panel.querySelector('#dh-clear').onclick = () => {
        const n = verdictCache.size; verdictCache.clear(); saveCache();
        ui.log('память очищена (' + n + ' вердиктов удалено)');
        ui.setStatus('память пуста');
      };

      // ручной запрос: показать ПОЛНОЕ рассуждение модели по одному токену
      panel.querySelector('#dh-ask').onclick = async () => {
        const token = panel.querySelector('#dh-q-token').value.trim();
        if (!token) { ui.log('введи слово'); return; }
        const ctx = panel.querySelector('#dh-q-ctx').value.trim() || token;
        const title = pageTitle();
        ui.setStatus('LLM: спрашиваю «' + token + '»…');
        ui.log('── ручной запрос: «' + token + '» ──');
        try {
          const msgs = buildLLMMessages(token, ctx, ctx.indexOf(token), title, true);
          const jobId = randId();
          const resp = await llmChat(jobId, msgs, { reasoning: true, max_tokens: 400 });
          if (!resp || !resp.ok) { ui.log('ошибка: ' + (resp && resp.error)); ui.setStatus('LLM: ошибка'); return; }
          const script = parseLLMVerdict(resp.raw || '');
          ui.log('вердикт: ' + (script || '—'));
          ui.log('── ответ модели ──');
          ui.log((resp.raw || '(пусто)').trim());
          ui.setStatus('LLM: ответ получен (' + (script || '—') + ')');
        } catch (e) { ui.log('сбой: ' + (e && e.message)); ui.setStatus('LLM: сбой'); }
      };
    }
    return {
      init() { if (document.body) build(); },
      log(m) { if (logBox) { logBox.textContent += m + '\n'; logBox.scrollTop = logBox.scrollHeight; } console.log('[dh] ' + m); },
      setStatus(s) { if (statusEl) statusEl.textContent = s; },
    };
  })();

  function start() {
    fullScan();      // ФАЗА 1: быстрая эвристика по всей странице
    hookHistory();   // реакция на SPA-переходы
    ui.init();
    setTimeout(() => { if (LLM.enabled) runLLMPhase(); }, 1500);  // ФАЗА 2
  }

  if (document.body) setTimeout(start, 800);
  else window.addEventListener('DOMContentLoaded', () => setTimeout(start, 800));
})();